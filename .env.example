# .env.example — copy to .env and fill in. Never commit .env.

# Required for the default (free) models — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the free models used (comma-separated OpenRouter IDs).
# The app's Setup tab lists the free models available right now.
# OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,liquid/lfm-3-1.7b:free

# Optional: judge model for RAGAS evaluation (a larger model works best)
# OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional extra cloud providers
# NVIDIA_API_KEY=      # https://build.nvidia.com
# GEMINI_API_KEY=      # https://aistudio.google.com
